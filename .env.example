# --- Storefront (copy to .env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: shown in the footer / contact page only when set
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_PINTEREST_URL=

# Optional: restrict next/image to your image host(s), comma separated.
# Leave empty during development; set it in production.
NEXT_PUBLIC_IMAGE_HOSTS=
