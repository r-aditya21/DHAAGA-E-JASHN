PORT=5000
NODE_ENV=development
MONGODB_URI=
# At least 32 random characters
JWT_SECRET=
# Comma separated list of storefront origins allowed by CORS
CLIENT_URL=http://localhost:3000
GOOGLE_CLIENT_ID=

# Use "none" only if the storefront and API are on different sites (needs HTTPS)
COOKIE_SAMESITE=lax

# Optional business rules
FREE_SHIPPING_THRESHOLD=1999
SHIPPING_FEE=99

# Razorpay (server-side only; never expose the secret to the frontend).
# Use a matching key pair from the same Test or Live account.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
